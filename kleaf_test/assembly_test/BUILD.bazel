load("@bazel_skylib//rules:build_test.bzl", "build_test")
load(
    "@kleaf//build/kernel/kleaf:kernel.bzl",
    "ddk_module",
)

ddk_module(
    name = "asopts",
    srcs = [
        "empty_module.c",
        "want_my_define.S",
    ],
    out = "asopts.ko",
    asopts = ["-DMY_DEFINE"],
    kernel_build = "@kleaf//common:kernel_aarch64",
)

ddk_module(
    name = "local_defines",
    srcs = [
        "empty_module.c",
        "want_my_define.S",
    ],
    out = "local_defines.ko",
    kernel_build = "@kleaf//common:kernel_aarch64",
    local_defines = ["MY_DEFINE"],
)

ddk_module(
    name = "includes",
    srcs = [
        "empty_module.c",
        "exported_includes/myinclude.h",
        "want_includes.S",
    ],
    out = "includes.ko",
    includes = ["exported_includes"],
    kernel_build = "@kleaf//common:kernel_aarch64",
)

build_test(
    name = "assembly_test",
    targets = [
        # keep sorted
        ":asopts",
        ":includes",
        ":local_defines",
    ],
)
